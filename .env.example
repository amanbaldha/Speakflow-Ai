# ─────────────────────────────────────────────────────────────────────────
# SpeakFlow — environment variables
# Copy this file to .env.local. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────

# ── Local AI model (Ollama + Gemma 4) ─────────────────────────────────────
# SpeakFlow runs its AI entirely locally now — no API key, no internet
# dependency for question generation, per-answer scoring, or the final
# report. This requires Ollama (https://ollama.com/download) installed and
# running on the machine that runs `npm run dev`, with the model pulled:
#   ollama pull gemma4:e4b
# OLLAMA_BASE_URL is where Ollama's local server listens (its default).
# OLLAMA_MODEL is the exact tag to use — bigger tags (12b, 26b, 31b) give
# better quality but need more RAM; smaller tags (e2b) are lighter and
# faster. See README.md for guidance on picking a size for your machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# ── Supabase (not wired up yet — safe to leave blank) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
