# ─────────────────────────────────────────────────────────────────────────
# SpeakFlow — environment variables
# Copy this file to .env.local (Next.js app) — the same values are also read
# by the agent worker process. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────

# ── LiveKit ────────────────────────────────────────────────────────────────
# Create a free project at https://cloud.livekit.io (or self-host LiveKit).
# Project Settings → Keys gives you the URL + API key/secret pair below.
# LIVEKIT_URL is the WebSocket URL (wss://...) used by the SERVER to mint
# tokens and by the AGENT WORKER to connect. NEXT_PUBLIC_LIVEKIT_URL is the
# same URL exposed to the BROWSER so it can open the WebRTC connection.
LIVEKIT_URL=wss://speakflow-ai-2s0m3d54.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://speakflow-ai-2s0m3d54.livekit.cloud
LIVEKIT_API_KEY=API8fCEMgCVBiQX
LIVEKIT_API_SECRET=0t6hQ5fk9Dg58b5PVstuf1VbSiD4rEDk4UrRPbBQQNj

# ── OpenAI ───────────────────────────────────────────────────────────────
# Needs access to the Realtime API (gpt-4o-realtime-preview / gpt-realtime)
# for the live voice agent, and a standard chat model for the (separate)
# English evaluator + session summary calls.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=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
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_EVAL_MODEL=gpt-4o-mini

# ── Supabase (wired up in Phase 4 — safe to leave blank for the Phase 1 MVP) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
